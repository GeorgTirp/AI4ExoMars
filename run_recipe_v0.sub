# ConvNeXt-Swin v0 with the current recipe (run_recipe_v0.sh).
#   condor_submit_bid 20 run_recipe_v0.sub
universe   = vanilla
initialdir = /home/gtirpitz/AI4ExoMars
executable = run_recipe_v0.sh
output = job_outputs/recipe_v0/v0.$(Cluster).out
error  = job_outputs/recipe_v0/v0.$(Cluster).err
log    = job_outputs/recipe_v0/v0.$(Cluster).log
request_cpus   = 8
request_memory = 12288
request_gpus   = 1
min_gpu_mem_mb = 40000
requirements   = (TARGET.CUDAGlobalMemoryMb >= $(min_gpu_mem_mb)) && \
                 (TARGET.CUDADeviceName == "NVIDIA A100-SXM4-40GB") && \
                 (TARGET.Machine =!= MY.LastRemoteHost) && \
                 (TARGET.Machine != "g155.internal.cluster.is.localnet")
getenv = True
+JobBatchName = "ai4exomars-recipe-v0"
MaxTime = 129600
periodic_hold = (JobStatus == 2) && ((CurrentTime - JobCurrentStartDate) >= $(MaxTime))
periodic_hold_reason = "Job runtime exceeded MaxTime"
on_exit_hold = (ExitCode != 0)
on_exit_hold_reason = "Recipe-transfer run exited non-zero -- check the .err log"
queue 1
