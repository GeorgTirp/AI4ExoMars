{
  "program": "vision_backend/train_stage1_simmim.py",
  "method": "bayes",
  "metric": {
    "name": "val/loss",
    "goal": "minimize"
  },
  "early_terminate": {
    "type": "hyperband",
    "min_iter": 100,
    "eta": 2
  },
  "parameters": {
    "data.index_path": { "value": "data/noah_simmim_crops/crops_index.csv" },
    "data.num_workers": { "value": 4 },
    "optim.effective_batch": { "value": 64 },
    "optim.total_steps": { "value": 400 },
    "output.checkpoint_dir": { "value": "checkpoints/stage1_simmim_noah_sweep" },
    "output.val_every": { "value": 100 },
    "output.panel_every": { "value": 200 },
    "output.checkpoint_every": { "value": 400 },
    "optim.base_lr": {
      "distribution": "log_uniform_values",
      "min": 3e-05,
      "max": 0.001
    },
    "optim.weight_decay": {
      "distribution": "log_uniform_values",
      "min": 0.001,
      "max": 0.1
    },
    "optim.warmup_fraction": { "values": [0.02, 0.05, 0.1] },
    "model.mask_ratio": { "values": [0.4, 0.5, 0.6, 0.75] },
    "model.drop_path": { "values": [0.0, 0.1, 0.2] },
    "model.loss_type": { "values": ["l1", "smooth_l1"] },
    "data.batch_size": { "values": [4, 8, 16] }
  }
}
