# E19 sequential campaigns with the diagonal Laplace filter (run_sequential.sh).
#   condor_submit_bid 20 run_sequential.sub
universe   = vanilla
initialdir = /home/gtirpitz/AI4ExoMars
executable = run_sequential.sh
output = job_outputs/block_sequential/seq.$(Cluster).out
error  = job_outputs/block_sequential/seq.$(Cluster).err
log    = job_outputs/block_sequential/seq.$(Cluster).log
request_cpus   = 8
request_memory = 24576
request_gpus   = 1
min_gpu_mem_mb = 40000
requirements   = (TARGET.CUDAGlobalMemoryMb >= $(min_gpu_mem_mb)) && \
                 (TARGET.CUDADeviceName == "NVIDIA A100-SXM4-40GB") && \
                 (TARGET.Machine =!= MY.LastRemoteHost) && \
                 (TARGET.Machine != "g155.internal.cluster.is.localnet")
getenv = True
+JobBatchName = "ai4exomars-sequential"
MaxTime = 10800
periodic_hold = (JobStatus == 2) && ((CurrentTime - JobCurrentStartDate) >= $(MaxTime))
periodic_hold_reason = "Job runtime exceeded MaxTime"
on_exit_hold = (ExitCode != 0)
on_exit_hold_reason = "Sequential campaigns exited non-zero -- check the .err log"
queue 1
