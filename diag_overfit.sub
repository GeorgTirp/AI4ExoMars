universe   = vanilla
initialdir = /home/gtirpitz/AI4ExoMars

executable = diag_overfit.sh

output = job_outputs/diag/diag.$(Cluster).$(Process).out
error  = job_outputs/diag/diag.$(Cluster).$(Process).err
log    = job_outputs/diag/diag.$(Cluster).log

request_cpus   = 8
request_memory = 32768
request_gpus   = 1
min_gpu_mem_mb = 24000
requirements   = (TARGET.CUDAGlobalMemoryMb >= $(min_gpu_mem_mb))

getenv = True

+JobBatchName = "ai4exomars-diag-overfit"

# A few hundred steps on a few hundred crops: minutes, not hours. The ceiling is
# here only so a hang cannot quietly bill a GPU slot all day.
MaxTime = 3600
periodic_hold = (JobStatus == 2) && ((CurrentTime - JobCurrentStartDate) >= $(MaxTime))
periodic_hold_reason = "Diagnostic exceeded MaxTime"

on_exit_hold = (ExitCode != 0)
on_exit_hold_reason = "Diagnostic exited non-zero -- check the .err log"

queue 1
