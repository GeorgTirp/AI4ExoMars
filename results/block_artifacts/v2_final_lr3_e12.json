  "preprocessing": {
    "input": "single-band HiRISE RED, raw DN, 0 = nodata, native 0.25 m/px",
    "stretch": "u8 = clip(round(58 + (DN - p1) / (p99 - p1) * (178 - 58)), 1, 255), DN 0 -> 0, with p1/p99 the observation's 1st/99th DN percentiles (the labelling export's preprocessing bounds) -- scripts/prep_expert_block_manifest.py:to_uint8(stretch='oxia'). Matches the Oxia training contrast; the export's own 0-255 stretch has ~2x the contrast and must not be used.",
    "model_input": "x = u8 / 127.5 - 1 as [B, 1, H, W], valid = (u8 != 0); blocks of 512 px, or multiples of 512 (tiled through the backbone at 512)"
  },
  "files": {
    "best.pt": "block classifier: load_block_classifier(path) in vision_backend/train_stage4_block_finetune.py",
    "eval.json": "test metrics; 'temperature' = T* for temperature-scaled probabilities softmax(logits / T)",
    "best.laplace.pt": "last-layer Laplace (uncertainty/block_laplace.py): la = load_last_layer_laplace(path); phi, offset = model.block_features(x, valid); logits = offset + model.fc(phi); la.predictive(logits, phi, method='probit' | 'mc') -> probs, entropy (+ aleatoric, mutual_information with 'mc')",
    "best.uncertainty.pt": "block Mahalanobis (MahalanobisStats over phi): uncertainty/malahanobis.py load_stats + mahalanobis_distance(phi, stats) / stats.reference_max_distance",
    "best.npca.pt": "block neural-PCA bases (schema v2, gallery empty): pc_align/neural_pca.py load_gallery_bases(path)[k]; psi = compute_block_psi(model.fc.weight, phi, k); rank_indices_by_component(psi, bases[k]) ranks the observation's blocks",
