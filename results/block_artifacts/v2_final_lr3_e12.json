    "segmenter.uncertainty.pt": "pixel Mahalanobis of segmenter.pt (uncertainty_mapping.epistemic_uncertainty_map)",
    "segmenter.npca.pt": "pixel neural-PCA bases of segmenter.pt (schema v2, gallery empty; psi = compute_psi_batch(seg, k, x))",
    "block_features.npz": "phi / offset / label / block_id / cell per split; refit the block-level files with scripts/fit_block_artifacts.py --from-features"
  }
}