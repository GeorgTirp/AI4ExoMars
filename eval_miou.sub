universe   = vanilla
initialdir = /home/gtirpitz/AI4ExoMars

executable = eval_miou.sh
arguments  = checkpoints/variant_v2/best_50ep_xt77z97l.pt checkpoints/variant_v3/best_50ep_pwym47z2.pt --batch-size 4 --loader-config-path data/2022-02-08_ABarrett_OU_HiRISE_NOAH-H_Mosaic/derived/seg_loader_DC_full.json --context-cache-dir data/2022-02-08_ABarrett_OU_HiRISE_NOAH-H_Mosaic/derived/seg_context_cache_full

output = job_outputs/eval/eval.$(Cluster).$(Process).out
error  = job_outputs/eval/eval.$(Cluster).$(Process).err
log    = job_outputs/eval/eval.$(Cluster).log

request_cpus   = 8
request_memory = 32768
request_gpus   = 1
min_gpu_mem_mb = 40000
requirements   = (TARGET.CUDAGlobalMemoryMb >= $(min_gpu_mem_mb)) && \
                 (TARGET.Machine != "g155.internal.cluster.is.localnet") && \
                 (TARGET.Machine =!= MY.LastRemoteHost)

getenv = True

+JobBatchName = "ai4exomars-eval-miou"

# A few hundred steps on a few hundred crops: minutes, not hours. The ceiling is
# here only so a hang cannot quietly bill a GPU slot all day.
MaxTime = 3600
periodic_hold = (JobStatus == 2) && ((CurrentTime - JobCurrentStartDate) >= $(MaxTime))
periodic_hold_reason = "Smoke run exceeded MaxTime -- it should take minutes"

on_exit_hold = (ExitCode != 0)
on_exit_hold_reason = "Smoke run exited non-zero -- check the .err log"

queue 1
