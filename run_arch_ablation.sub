# Architecture ablations of the HybridEncoder at the tuned recipe (run_arch_ablation.sh).
#   ABLATION=no_global condor_submit_bid 20 run_arch_ablation.sub
#   ABLATION=s3_depth2 condor_submit_bid 20 run_arch_ablation.sub
universe   = vanilla
initialdir = /home/gtirpitz/AI4ExoMars
executable = run_arch_ablation.sh
ABLATION = $ENV(ABLATION:NOTSET)
output = job_outputs/arch_ablation/$(ABLATION).$(Cluster).out
error  = job_outputs/arch_ablation/$(ABLATION).$(Cluster).err
log    = job_outputs/arch_ablation/$(ABLATION).$(Cluster).log
request_cpus   = 8
request_memory = 12288
request_gpus   = 1
min_gpu_mem_mb = 40000
requirements   = (TARGET.CUDAGlobalMemoryMb >= $(min_gpu_mem_mb)) && \
                 (TARGET.CUDADeviceName == "NVIDIA A100-SXM4-40GB") && \
                 (TARGET.Machine =!= MY.LastRemoteHost) && \
                 (TARGET.Machine != "g155.internal.cluster.is.localnet")
getenv = True
+JobBatchName = "ai4exomars-arch-ablation"
MaxTime = 129600
periodic_hold = (JobStatus == 2) && ((CurrentTime - JobCurrentStartDate) >= $(MaxTime))
periodic_hold_reason = "Job runtime exceeded MaxTime"
on_exit_hold = (ExitCode != 0)
on_exit_hold_reason = "Architecture ablation exited non-zero -- check the .err log"
queue 1
