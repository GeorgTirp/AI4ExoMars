# Stage-4 hyperparameter tuning: one configuration over all spatial CV folds (run_block_cv.sh).
#   CONFIG=lr1_e12 SEG_LR_SCALE=1 EPOCHS=12 TAU=645 condor_submit_bid 20 run_block_cv.sub
universe   = vanilla
initialdir = /home/gtirpitz/AI4ExoMars
executable = run_block_cv.sh
CONFIG = $ENV(CONFIG:NOTSET)
output = job_outputs/block_cv/$(CONFIG).$(Cluster).out
error  = job_outputs/block_cv/$(CONFIG).$(Cluster).err
log    = job_outputs/block_cv/$(CONFIG).$(Cluster).log
request_cpus   = 8
request_memory = 24576
request_gpus   = 1
min_gpu_mem_mb = 40000
requirements   = (TARGET.CUDAGlobalMemoryMb >= $(min_gpu_mem_mb)) && \
                 (TARGET.CUDADeviceName == "NVIDIA A100-SXM4-40GB") && \
                 (TARGET.Machine =!= MY.LastRemoteHost) && \
                 (TARGET.Machine != "g155.internal.cluster.is.localnet")
getenv = True
+JobBatchName = "ai4exomars-block-cv"
MaxTime = 28800
periodic_hold = (JobStatus == 2) && ((CurrentTime - JobCurrentStartDate) >= $(MaxTime))
periodic_hold_reason = "Job runtime exceeded MaxTime"
on_exit_hold = (ExitCode != 0)
on_exit_hold_reason = "Block CV exited non-zero -- check the .err log"
queue 1
