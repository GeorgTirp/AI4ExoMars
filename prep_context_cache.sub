universe   = vanilla
initialdir = /home/gtirpitz/AI4ExoMars

executable = prep_context_cache.sh

output = job_outputs/prep_context_cache/build.$(Cluster).$(Process).out
error  = job_outputs/prep_context_cache/build.$(Cluster).$(Process).err
log    = job_outputs/prep_context_cache/build.$(Cluster).log

# No GPU: this is a single-threaded rasterio read loop over the 10 GB mosaic.
request_cpus   = 2
request_memory = 32768
request_disk   = 4096

getenv = True

+JobBatchName = "ai4exomars-context-cache"

# ~1 h expected; 6 h ceiling leaves room for a cold/contended filesystem.
MaxTime = 21600
periodic_hold = (JobStatus == 2) && ((CurrentTime - JobCurrentStartDate) >= $(MaxTime))
periodic_hold_reason = "Context cache build exceeded MaxTime"

# A non-zero exit means the build failed its own content verification. Do not
# retry silently -- a half-written or misaligned cache must not reach V1/V3.
on_exit_hold = (ExitCode != 0)
on_exit_hold_reason = "Context cache build exited non-zero -- check the .err log"

queue 1
